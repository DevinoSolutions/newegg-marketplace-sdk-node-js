{
  "name": "@joinmarka/newegg-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing safe, narrowly-scoped Newegg Marketplace inventory tools (stdio + Streamable HTTP).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevinoSolutions/newegg-marketplace-sdk-node-js.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/DevinoSolutions/newegg-marketplace-sdk-node-js/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/DevinoSolutions/newegg-marketplace-sdk-node-js/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "newegg",
    "marketplace",
    "mcp",
    "model-context-protocol",
    "inventory",
    "marka"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "newegg-marketplace-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@joinmarka/newegg": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
