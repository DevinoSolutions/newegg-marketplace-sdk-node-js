{
  // Typechecks the repo tooling in scripts/ (run via tsx, which strips types
  // WITHOUT checking them — this config is what keeps the scripts honest).
  // Wired into the root "typecheck" npm script.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"]
}
