# ---------------------------------------------------------------------------
# Newegg Marketplace credentials (never commit real values)
# Credentials belong to a SELLER ACCOUNT, not to a URL prefix: Newegg ignores /b2b/ and /can/ when
# authenticating, so keys issued for one marketplace would silently serve THAT account under another.
# The MCP server therefore binds credentials to NEWEGG_MARKETPLACE (ADR 0006). Use ONE of:
#   A) per-marketplace names for the marketplace you select (all three required):
#        NEWEGG_US_SELLER_ID / NEWEGG_US_API_KEY / NEWEGG_US_SECRET_KEY   (likewise NEWEGG_B2B_*, NEWEGG_CA_*)
#   B) the unprefixed names below PLUS NEWEGG_CREDENTIALS_MARKETPLACE (the marketplace they were issued
#      for; must equal NEWEGG_MARKETPLACE or the server refuses to start).
# ---------------------------------------------------------------------------
NEWEGG_SELLER_ID=YOUR_SELLER_ID
NEWEGG_API_KEY=YOUR_API_KEY
NEWEGG_SECRET_KEY=YOUR_SECRET_KEY
# one of: us | b2b | ca
NEWEGG_MARKETPLACE=us
# the marketplace the unprefixed keys above were issued for (us | b2b | ca); must equal NEWEGG_MARKETPLACE
NEWEGG_CREDENTIALS_MARKETPLACE=us
# Optional trusted override for tests/proxies (defaults to the official endpoint). Must be a newegg.com
# https host or loopback; any other host also needs NEWEGG_MCP_ALLOW_CUSTOM_BASE_URL=true (MCP server).
# NEWEGG_API_BASE_URL=https://api.newegg.com/marketplace/

# ---------------------------------------------------------------------------
# MCP server configuration
# ---------------------------------------------------------------------------
# Writes are DISABLED by default; the preview and apply tools are not even registered unless true.
# With the HTTP transport, true also REQUIRES NEWEGG_MCP_HTTP_BEARER_TOKEN below, even on loopback.
NEWEGG_MCP_ALLOW_WRITES=false
NEWEGG_MCP_MAX_ITEMS_PER_OPERATION=500
NEWEGG_MCP_PREVIEW_TTL_SECONDS=600
NEWEGG_MCP_ALLOW_ZERO_QUANTITY=true
# Largest % change a single price update may make vs the current price (bigger = blocked at preview).
# Plain decimal only (e.g. 50 or 12.5): no 0x/sign/exponent.
NEWEGG_MCP_MAX_PRICE_CHANGE_PERCENT=50
# Largest courtesy refund / refund-RMA total one preview may plan (marketplace currency).
# Plain decimal only (e.g. 500 or 49.99): no 0x/sign/exponent.
NEWEGG_MCP_MAX_REFUND_AMOUNT=500
# Ceiling on the quoted cost of one UPS shipping label purchase (marketplace currency; default 100
# when empty). A plain decimal (e.g. 100 or 49.99). A reprint (no quote) is blocked while a cap is active
# unless NEWEGG_MCP_ALLOW_LABEL_REPRINT=true. "unlimited" disables the cap.
NEWEGG_MCP_MAX_LABEL_AMOUNT=
# Exactly "true" lets a label reprint (no quote, billing unknown) through the cap above, e.g. to recover
# a label after an indeterminate create. Needs NEWEGG_MCP_ALLOW_WRITES=true (re-checked at apply). Default: blocked.
NEWEGG_MCP_ALLOW_LABEL_REPRINT=
# A reprint may be charged (amount unknown), so every reprint is limited, whether or not it passes the cap:
# one per order per cooldown (seconds, 1-86400, default 600) and N per rolling hour (1-1000, default 6).
# Whole numbers only; counted in memory per server process, so they reset on restart.
NEWEGG_MCP_LABEL_REPRINT_COOLDOWN_SECONDS=
NEWEGG_MCP_MAX_LABEL_REPRINTS_PER_HOUR=
# Comma-separated allowlists; empty = allow all
NEWEGG_MCP_ALLOWED_WAREHOUSES=
NEWEGG_MCP_ALLOWED_MARKETPLACES=
# Streamable HTTP transport (stdio is the default transport)
NEWEGG_MCP_HTTP_HOST=127.0.0.1
NEWEGG_MCP_HTTP_PORT=3919
# Required before binding to a non-loopback host AND whenever NEWEGG_MCP_ALLOW_WRITES=true over HTTP;
# at least 32 characters, 12 different (openssl rand -hex 32):
NEWEGG_MCP_HTTP_BEARER_TOKEN=
# Concurrent HTTP sessions (default 32) and idle seconds before a session is closed (default 1800):
NEWEGG_MCP_HTTP_MAX_SESSIONS=
NEWEGG_MCP_HTTP_SESSION_IDLE_SECONDS=
# Exactly "true" confirms a TLS-terminating proxy fronts this plain-HTTP listener (silences the warning):
NEWEGG_MCP_HTTP_BEHIND_TLS_PROXY=
# Exactly "true" makes the report file download use explicit FTPS (default: plain FTP, Newegg's certificate
# is self-signed, so also pin its SHA-256 fingerprint; the pin stops passive eavesdropping, not an active
# man-in-the-middle, because the stock Serv-U certificate key is probably shared):
NEWEGG_MCP_REPORT_FTPS=
# Path to the server certificate PEM (contracts 17.5); certificate validation is never disabled:
NEWEGG_MCP_REPORT_FTPS_CA_FILE=
NEWEGG_MCP_REPORT_FTPS_CERT_SHA256=
# Comma-separated allowed Origin values for browser-based clients (empty = same-origin only)
NEWEGG_MCP_HTTP_ALLOWED_ORIGINS=
# Comma-separated allowed Host header values (host[:port]); loopback hosts always allowed
NEWEGG_MCP_HTTP_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Live smoke tests (opt-in; NEVER run in CI). The live suite is READ-ONLY — it performs no
# writes to your account. Set NEWEGG_LIVE_TESTS=true (plus the credentials above) to run the
# credential preflight + service-status reads. To ALSO exercise inventory READS, set
# NEWEGG_LIVE_TEST_SELLER_PART_NUMBER to one of your real SKUs (and NEWEGG_LIVE_TEST_WAREHOUSE
# on US only); otherwise those tests skip cleanly. Run:
#   NEWEGG_LIVE_TESTS=true npm run test:live          # fast reads
#   NEWEGG_LIVE_TESTS=true npm run test:live:reports  # slow report / catalog-lookup polling
# ---------------------------------------------------------------------------
NEWEGG_LIVE_TESTS=false
NEWEGG_LIVE_TEST_SELLER_PART_NUMBER=
NEWEGG_LIVE_TEST_WAREHOUSE=
# The suite has NO write test; writes to a real account are intentionally not automated.
# It runs only when NEWEGG_LIVE_TESTS=true and the three credentials above are set.
