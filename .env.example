# ---------------------------------------------------------------------------
# Newegg Marketplace credentials (never commit real values)
# Credentials are PLATFORM-SPECIFIC: a US key is not valid for B2B or CA.
# ---------------------------------------------------------------------------
NEWEGG_SELLER_ID=YOUR_SELLER_ID
NEWEGG_API_KEY=YOUR_API_KEY
NEWEGG_SECRET_KEY=YOUR_SECRET_KEY
# one of: us | b2b | ca
NEWEGG_MARKETPLACE=us
# Optional trusted override for tests/proxies (defaults to the official endpoint)
# NEWEGG_API_BASE_URL=https://api.newegg.com/marketplace/

# ---------------------------------------------------------------------------
# MCP server configuration
# ---------------------------------------------------------------------------
# Writes are DISABLED by default; the apply tool is not even registered unless true.
NEWEGG_MCP_ALLOW_WRITES=false
NEWEGG_MCP_MAX_ITEMS_PER_OPERATION=500
NEWEGG_MCP_PREVIEW_TTL_SECONDS=600
NEWEGG_MCP_ALLOW_ZERO_QUANTITY=true
# Comma-separated allowlists; empty = allow all
NEWEGG_MCP_ALLOWED_WAREHOUSES=
NEWEGG_MCP_ALLOWED_MARKETPLACES=
# Streamable HTTP transport (stdio is the default transport)
NEWEGG_MCP_HTTP_HOST=127.0.0.1
NEWEGG_MCP_HTTP_PORT=3919
# Required before binding to a non-loopback host:
NEWEGG_MCP_HTTP_BEARER_TOKEN=
# Comma-separated allowed Origin values for browser-based clients (empty = same-origin only)
NEWEGG_MCP_HTTP_ALLOWED_ORIGINS=
# Comma-separated allowed Host header values (host[:port]); loopback hosts always allowed
NEWEGG_MCP_HTTP_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Live smoke tests (opt-in; NEVER run in CI). The live suite is READ-ONLY — it performs no
# writes to your account. Set NEWEGG_LIVE_TESTS=true (plus the credentials above) to run the
# credential preflight + service-status reads. To ALSO exercise inventory READS, set
# NEWEGG_LIVE_TEST_SELLER_PART_NUMBER to one of your real SKUs (and NEWEGG_LIVE_TEST_WAREHOUSE
# on US only); otherwise those tests skip cleanly. Run:
#   NEWEGG_LIVE_TESTS=true npx vitest run --config packages/sdk/vitest.live.config.ts
# ---------------------------------------------------------------------------
NEWEGG_LIVE_TESTS=false
NEWEGG_LIVE_TEST_SELLER_PART_NUMBER=
NEWEGG_LIVE_TEST_WAREHOUSE=
# (Reserved) The test suite has NO write test — writes to a real account are intentionally not
# automated. Leave this unset.
NEWEGG_LIVE_TESTS_I_UNDERSTAND_THIS_TOUCHES_A_REAL_ACCOUNT=
